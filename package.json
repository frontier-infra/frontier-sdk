{
  "name": "frontier-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/typescript/*"
  ],
  "scripts": {
    "test:node": "node --test packages/typescript/protocol/test/*.test.mjs packages/typescript/audit/test/*.test.mjs packages/typescript/harness-kit/test/*.test.mjs packages/typescript/adapters/test/*.test.mjs packages/typescript/create-frontier-app/test/*.test.mjs packages/typescript/governance-react/test/*.test.mjs",
    "test:chaos": "npm run test:chaos --workspace @frontier-infra/harness-kit",
    "test:types": "npm run test:types --workspace @frontier-infra/harness-kit",
    "test:python": "PYTHONPATH=packages/python/frontier-protocol/src python3 -m unittest discover -s packages/python/frontier-protocol/tests -v",
    "sync:consumers": "node scripts/sync-consumers.mjs",
    "check:consumers": "node scripts/sync-consumers.mjs --check",
    "sync:audit": "node scripts/sync-audit-snapshots.mjs",
    "check:audit": "node scripts/sync-audit-snapshots.mjs --check",
    "rc:pack": "node scripts/rc-pack.mjs",
    "rc:verify": "node scripts/rc-verify.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
