PORT=8787
FRONTIER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave VITE_API_BASE empty for same-origin browser requests through the Vite
# proxy. Set it only when the UI is intentionally served from a different
# origin and that origin is listed in FRONTIER_ALLOWED_ORIGINS.
VITE_API_BASE=

# OpenAI-compatible provider surface. The template exposes these settings but
# does not ship a production model integration.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

FRONTIER_DEPLOYMENT_ID=local-governed-worker
FRONTIER_OPERATOR_ID=operator-local
FRONTIER_WORKER_ID=worker-local
FRONTIER_VERIFIER_ID=verifier-local

POSTGRES_URL=postgres://frontier:frontier@localhost:5432/frontier
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=frontier-local
S3_ACCESS_KEY_ID=frontier
S3_SECRET_ACCESS_KEY=frontier-local-secret
